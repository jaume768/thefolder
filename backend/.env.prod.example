# ============================================================
# Variables de entorno del BACKEND en producción
# Copia este archivo como .env dentro de backend/
# ============================================================

NODE_ENV=production
PORT=5000
SESSION_SECRET=GENERA_UN_STRING_ALEATORIO_LARGO_AQUI

# Cloudinary (imágenes y archivos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_cloudinary_api_key
CLOUDINARY_API_SECRET=tu_cloudinary_api_secret

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
GOOGLE_CALLBACK_URL=https://api.thefolder.es/api/auth/google/callback

# Brevo (emails transaccionales)
BREVO_API_KEY=tu_brevo_api_key
SENDER_EMAIL=noreply@thefolder.es
SENDER_NAME=TheFolder

# JWT
JWT_SECRET=GENERA_UN_STRING_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# MongoDB (usuario y password deben coincidir con .env de la raíz)
MONGO_URI=mongodb://thefolder_admin:CAMBIA_ESTO_password_seguro_aqui@mongo:27017/thefolder?authSource=admin

# Frontend URL (para redirecciones OAuth)
FRONTEND_URL=https://thefolder.es
